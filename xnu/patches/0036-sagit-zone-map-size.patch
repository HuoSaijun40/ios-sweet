diff --git a/osfmk/kern/zalloc.c b/osfmk/kern/zalloc.c
--- a/osfmk/kern/zalloc.c
+++ b/osfmk/kern/zalloc.c
@@ -160,9 +160,18 @@
 #define ZONE_GUARD_SPARSE       (64  * 1024)
 #endif /* ZSECURITY_CONFIG(SAD_FENG_SHUI) */
 
-#if XNU_PLATFORM_MacOSX
+#if XNU_PLATFORM_MacOSX && !defined(SAGIT)
 #define ZONE_MAP_MAX            (32ULL << 30)
 #define ZONE_MAP_VA_SIZE        (128ULL << 30)
+#elif XNU_PLATFORM_MacOSX
+/*
+ * SAGIT runs the macOS kernel config on the 39-bit (4KB page) VA layout, which
+ * has only ~44GB of usable kernel VA: a 128GB zone map cannot be placed, and
+ * capping the kmem claim instead breaks zone_init()'s ZONE_MAP_VA_SIZE-based
+ * submap arithmetic.  Use the embedded zone-map sizing.
+ */
+#define ZONE_MAP_MAX            (8ULL << 30)
+#define ZONE_MAP_VA_SIZE        (24ULL << 30)
 #else /* XNU_PLATFORM_MacOSX */
 #define ZONE_MAP_MAX            (8ULL << 30)
 #define ZONE_MAP_VA_SIZE        (24ULL << 30)
