diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -1013,6 +1013,14 @@
 	ldp		x2, x3, [sp], #16
 	ldp		x0, x1, [sp], #16
 #endif /* SAGIT */
+
+#if defined(SAGIT)
+	/* Install the diagnostic vectors just before the MMU goes on. */
+	adrp	x0, Lsagit_vectors@page
+	add		x0, x0, Lsagit_vectors@pageoff
+	msr		vbar_el1, x0
+	isb
+#endif
 	MOV64   x0, SCTLR_EL1_DEFAULT
 	MSR_SCTLR_EL1_X0
 	isb		sy
@@ -1168,3 +1176,26 @@
 //#include	"globals_asm.h"
 
 /* vim: set ts=4: */
+
+#if defined(SAGIT)
+	/*
+	 * SAGIT diagnostic exception vectors.
+	 *
+	 * Drawing the fault needs a working mapping, which is the very thing that
+	 * may have failed. So the handler just asks PSCI to reset the machine:
+	 * a reboot is the signal, and it needs no translation at all.
+	 */
+	.align 11
+Lsagit_vectors:
+	.rept	16
+	b		Lsagit_fault
+	.balign	128
+	.endr
+
+Lsagit_fault:
+	mov		x0, #0x9			/* PSCI SYSTEM_RESET */
+	movk	x0, #0x8400, lsl #16
+	smc		#0
+Lsagit_fault_hang:
+	b		.
+#endif /* SAGIT */
