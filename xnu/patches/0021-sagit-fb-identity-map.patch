diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -630,18 +630,38 @@
 
 #if defined(SAGIT)
 	/*
-	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
-	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
-	 * create_bootstrap_mapping would replace the RAM L2 table.
-	 * SAGIT uses 16K pages and all bring-up RAM is below 4GB, so the first
-	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
+	 * Splash framebuffer, identity mapped at 0x9d400000.
+	 *
+	 * With 16K pages an L1 entry covers 1GB, so the framebuffer (L1 index 2)
+	 * and the RAM window at 0x100000000 (L1 index 4) do NOT share a table.
+	 * The previous version wrote the FB entry into the RAM L2 page and used a
+	 * block descriptor whose PA field (0x9d400000) is not 32MB aligned, so
+	 * 0x9d400000 was never actually mapped -- the early console faulted on its
+	 * first pixel write.
+	 *
+	 * Allocate one more L2 page from the bootstrap pool, zero it, point L1[2]
+	 * at it, and install the 32MB block that contains the framebuffer.
 	 */
 	MOV64	x10, 0x9d400000
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
-	orr		x11, x11, x10
+	MOV64	x14, 0xfffffe000000		/* 32MB block alignment mask */
+	and		x14, x10, x14
+	orr		x11, x11, x14
+
+	add		x13, x2, #(PGBYTES)		/* next free bootstrap page */
+	mov		x16, #(TTE_PGENTRIES)
+	mov		x17, x13
+1:	str		xzr, [x17], #8
+	subs	x16, x16, #1
+	b.ne	1b
+
+	orr		x17, x13, #(ARM_TTE_BOOT_TABLE)
+	and		x12, x10, #(ARM_TT_L1_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L1_SHIFT)
+	str		x17, [x25, x12, lsl #TTE_SHIFT]
+
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
-	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
 #endif
 
