diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -630,19 +630,21 @@
 
 #if defined(SAGIT)
 	/*
-	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
-	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
-	 * create_bootstrap_mapping would replace the RAM L2 table.
-	 * SAGIT uses 16K pages and all bring-up RAM is below 4GB, so the first
-	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
+	 * Splash framebuffer, identity mapped through TTBR0.
+	 *
+	 * 4KB pages: one L1 entry covers 1GB, and 0x9d400000 lives in the 1GB
+	 * block at 0x80000000.  create_bootstrap_mapping only allocates L1
+	 * entries from the kernel's physical base (0x100000000, L1 index 4), so
+	 * L1 index 2 is free and one block descriptor is enough.  Normal
+	 * non-cacheable keeps the early console and the Stage-1 marker visible
+	 * without cache maintenance, and nothing else in the low bank is used.
 	 */
-	MOV64	x10, 0x9d400000
+	MOV64	x10, 0x80000000			/* 1GB block holding the framebuffer */
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
-	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
-	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
-	add		x13, x25, #(2 * PGBYTES)
-	str		x11, [x13, x12, lsl #TTE_SHIFT]
+	and		x12, x10, #(ARM_TT_L1_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L1_SHIFT)
+	str		x11, [x25, x12, lsl #TTE_SHIFT]
 #endif
 
 	/* Ensure TTEs are visible */
