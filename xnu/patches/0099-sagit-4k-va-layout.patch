diff --git a/osfmk/mach/arm/vm_param.h b/osfmk/mach/arm/vm_param.h
--- a/osfmk/mach/arm/vm_param.h
+++ b/osfmk/mach/arm/vm_param.h
@@ -134,7 +134,17 @@
 /* system-wide values */
 #define MACH_VM_MIN_ADDRESS_RAW 0x0ULL
 #if defined(XNU_PLATFORM_MacOSX) || defined(XNU_PLATFORM_DriverKit)
+#if defined(ARM64_BOARD_CONFIG_SAGIT) && !defined(__ARM_16K_PG__)
+/*
+ * sagit: the 4 KB granule needs the commpage (fixed at 0x0000000FFFFFC000 by
+ * cpu_capabilities.h) to sit above the user VA limit, or pmap.c's
+ * ARM_PGSHIFT == 12 static assert fails. That is the non-macOS value; the
+ * macOS/kernel 128 TB value only works with 16 KB pages.
+ */
+#define MACH_VM_MAX_ADDRESS_RAW 0x0000000FC0000000ULL
+#else
 #define MACH_VM_MAX_ADDRESS_RAW 0x00007FFFFE000000ULL
+#endif
 #else
 #define MACH_VM_MAX_ADDRESS_RAW 0x0000000FC0000000ULL
 #endif
