diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -781,6 +781,27 @@
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+#if defined(SAGIT)
+	/* Stage 1: reached only if the MMU/cache enable above survived. The splash
+	 * framebuffer is mapped V=P Normal-NC by the bootstrap tables, so the same
+	 * identity address still works here. x0-x5 are scratch at this point. */
+	MOV64	x0, (0x9d400000 + 1840 * 4320)
+	mov		w1, #-1
+	mov		x2, #32
+	mov		x4, #4320
+Lsagit_mark2_row:
+	mov		x3, #64
+	mov		x5, x0
+Lsagit_mark2_pixel:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Lsagit_mark2_pixel
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lsagit_mark2_row
+	dsb		sy
+#endif /* SAGIT */
+
 #if !VMAPPLE && !defined(SAGIT)
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
