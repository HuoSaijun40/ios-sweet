diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -781,6 +781,39 @@
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+#if defined(SAGIT)
+	/*
+	 * Stage 1: must NOT fault.
+	 *
+	 * The framebuffer (0x9d400000) and other low physical addresses are not
+	 * reachable once the MMU is on -- TTBR0 is not set up for them here -- and
+	 * a fault goes through a VBAR that is itself invalid, so it leaves no
+	 * trace. That made every previous Stage-1 variant indistinguishable from
+	 * "the kernel died before it".
+	 *
+	 * Write into the KVA window instead: [virtBase, virtBase + memSize) is
+	 * mapped by create_bootstrap_mapping above (the kernel's own code runs
+	 * there), so this access is guaranteed to succeed. The signal we are
+	 * after is now simply whether execution continues to arm_vm_init and its
+	 * early console.
+	 */
+	MOV64	x9, 0xA0000000
+	add	x0, x22, x9
+	mov	w1, #-1
+	mov	x2, #8
+Lsagit_mark2_row:
+	mov	x3, #64
+	mov	x5, x0
+Lsagit_mark2_pixel:
+	str	w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Lsagit_mark2_pixel
+	add	x0, x0, #256
+	subs	x2, x2, #1
+	b.ne	Lsagit_mark2_row
+	dsb	sy
+#endif /* SAGIT */
+
 #if !VMAPPLE && !defined(SAGIT)
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
