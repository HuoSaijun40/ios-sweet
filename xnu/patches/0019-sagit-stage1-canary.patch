diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -781,6 +781,35 @@
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+#if defined(SAGIT)
+	/*
+	 * Stage 1: reached only if the MMU/cache enable above survived.
+	 *
+	 * Draws through the TTBR1 framebuffer alias that patch 0021 installs:
+	 *   VA = virtBase + 0x10000000000 + 0x1400000 + 1840*4320
+	 * A white band appears only if post-MMU framebuffer writes work, which
+	 * also proves the bootstrap mapping and the alias are usable.
+	 */
+	MOV64	x9, 0x10000000000
+	add	x0, x22, x9
+	MOV64	x9, 0x1B94A00			/* 0x1400000 (FB in block) + row 1840 */
+	add	x0, x0, x9
+	mov	w1, #-1
+	mov	x2, #32
+	mov	x4, #4320
+Lsagit_mark2_row:
+	mov	x3, #64
+	mov	x5, x0
+Lsagit_mark2_pixel:
+	str	w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Lsagit_mark2_pixel
+	add	x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lsagit_mark2_row
+	dsb	sy
+#endif /* SAGIT */
+
 #if !VMAPPLE && !defined(SAGIT)
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
