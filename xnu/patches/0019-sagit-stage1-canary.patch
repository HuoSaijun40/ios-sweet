diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -781,6 +781,39 @@
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+#if defined(SAGIT)
+	/*
+	 * Stage 1: reached only if the MMU/cache enable survived. Writes to plain
+	 * RAM (not the framebuffer), and records LR -- the address this code will
+	 * eventually `ret` to -- so the next boot's shim can report both.
+	 *
+	 *   PA 0x1a0008000 : 0xffffffff   stage 1 ran
+	 *   PA 0x1a0000008 : 2            end of this block reached
+	 *   PA 0x1a0000010 : LR value     where start.s will jump next
+	 */
+	MOV64	x0, 0x1A0008000
+	mov		w1, #-1
+	mov		x2, #32
+	mov		x4, #4320
+Lsagit_mark2_row:
+	mov		x3, #64
+	mov		x5, x0
+Lsagit_mark2_pixel:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Lsagit_mark2_pixel
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lsagit_mark2_row
+
+	MOV64	x9, 0x1A0000008
+	mov		w10, #2
+	str		w10, [x9]
+	MOV64	x9, 0x1A0000010
+	str		x30, [x9]
+	dsb		sy
+#endif /* SAGIT */
+
 #if !VMAPPLE && !defined(SAGIT)
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
