diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -676,6 +676,35 @@
 #endif
 
 	// Set the translation control register.
+
+#if defined(SAGIT)
+	/* SAGIT marker A: pre-MMU, physical address, cannot fault. */
+	sub		sp, sp, #96
+	stp		x0, x1, [sp]
+	stp		x2, x3, [sp, #16]
+	stp		x4, x5, [sp, #32]
+	stp		x6, x7, [sp, #48]
+	MOV64	x0, (0x9d400000 + 1872 * 4320)
+	mov		w1, #-1
+	mov		x2, #8
+	mov		x4, #4320
+Lsagit_bisectA_row:
+	mov		x3, #64
+	mov		x5, x0
+Lsagit_bisectA_pix:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Lsagit_bisectA_pix
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lsagit_bisectA_row
+	dsb		sy
+	ldp		x0, x1, [sp]
+	ldp		x2, x3, [sp, #16]
+	ldp		x4, x5, [sp, #32]
+	ldp		x6, x7, [sp, #48]
+	add		sp, sp, #96
+#endif /* SAGIT */
 	adrp	x0,     EXT(sysreg_restore)@page		// Load TCR value from the system register restore structure
 	add		x0, x0, EXT(sysreg_restore)@pageoff
 	ldr		x1, [x0, SR_RESTORE_TCR_EL1]
@@ -777,6 +806,35 @@
 #endif /* HAS_APPLE_PAC */
 
 	// Enable caches, MMU, ROP and JOP
+
+#if defined(SAGIT)
+	/* SAGIT marker B: pre-MMU, physical address, cannot fault. */
+	sub		sp, sp, #96
+	stp		x0, x1, [sp]
+	stp		x2, x3, [sp, #16]
+	stp		x4, x5, [sp, #32]
+	stp		x6, x7, [sp, #48]
+	MOV64	x0, (0x9d400000 + 1856 * 4320)
+	mov		w1, #-1
+	mov		x2, #8
+	mov		x4, #4320
+Lsagit_bisectB_row:
+	mov		x3, #64
+	mov		x5, x0
+Lsagit_bisectB_pix:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Lsagit_bisectB_pix
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lsagit_bisectB_row
+	dsb		sy
+	ldp		x0, x1, [sp]
+	ldp		x2, x3, [sp, #16]
+	ldp		x4, x5, [sp, #32]
+	ldp		x6, x7, [sp, #48]
+	add		sp, sp, #96
+#endif /* SAGIT */
 	MOV64   x0, SCTLR_EL1_DEFAULT
 	MSR_SCTLR_EL1_X0
 	isb		sy
