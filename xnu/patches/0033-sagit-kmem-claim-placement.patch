+#if defined(SAGIT)
+static vm_map_size_t kmem_sagit_hole_size;
+static vm_map_offset_t kmem_sagit_hole_start;
+
+/*
+ * The 39-bit (4KB page) kernel map is small and pmap_bootstrap fills it with
+ * big static/physmap entries.  vm_map_sizes() computes each hole as
+ * `vme_start - prev`, which wraps to a garbage ~2^50 as soon as an entry is out
+ * of order or overlaps, and every kmem claim was then sized from that number
+ * (ptr=128TB, data=16EB on the phone).  Walk the entries monotonically and
+ * remember both the largest hole's size and where it starts, so the claims can
+ * be laid out contiguously inside it.
+ */
+static void
+kmem_sagit_find_largest_hole(void)
+{
+	vm_map_entry_t e;
+	vm_map_offset_t prev = kernel_map->min_offset;
+	vm_map_offset_t best_start = kernel_map->min_offset;
+	vm_map_size_t best = 0;
+#if DEVELOPMENT || DEBUG
+	int shown = 0;
+#endif
+
+	for (e = vm_map_first_entry(kernel_map); e != vm_map_to_entry(kernel_map); e = e->vme_next) {
+#if DEVELOPMENT || DEBUG
+		if (shown < 8) {
+			printf("SAGIT kmem entry %p-%p\n",
+			    (void *)e->vme_start, (void *)e->vme_end);
+			shown++;
+		}
+#endif
+		if (e->vme_end <= prev) {
+			continue;
+		}
+		if (e->vme_start > prev && (e->vme_start - prev) > best) {
+			best = e->vme_start - prev;
+			best_start = prev;
+		}
+		prev = e->vme_end;
+	}
+	if (kernel_map->max_offset > prev && (kernel_map->max_offset - prev) > best) {
+		best = kernel_map->max_offset - prev;
+		best_start = prev;
+	}
+	kmem_sagit_hole_size = trunc_page(best);
+	kmem_sagit_hole_start = best_start;
+#if DEVELOPMENT || DEBUG
+	printf("SAGIT kmem largest=%lluMB at=%p\n",
+	    (unsigned long long)(kmem_sagit_hole_size >> 20), (void *)best_start);
+#endif
+}
+#endif /* SAGIT */
