diff --git a/osfmk/vm/vm_kern.c b/osfmk/vm/vm_kern.c
--- a/osfmk/vm/vm_kern.c
+++ b/osfmk/vm/vm_kern.c
@@ -3619,13 +3619,33 @@
 	 * pointer packing schemes using KERNEL_PMAP_HEAP_RANGE_START as a base
 	 * do not admit this address to be part of any zone submap.
 	 */
+#if defined(SAGIT)
+	/*
+	 * The 39-bit kernel map is only ~112GB and is split by the kernel image and
+	 * the 3GB physmap into a 64GB hole below LOW_GLOBAL_BASE and a 45GB one
+	 * above the physmap.  The kmem claims are sized from the largest hole, so
+	 * they must be placed contiguously from its bottom; the fuzz allocation can
+	 * land in the other hole, which makes the placement fail.
+	 */
+	start = kernel_map->min_offset;
+#else
 	start = kmem_fuzz_start();
+#endif
 
 	/*
 	 * Add claims for ptr and data kmem_ranges
 	 */
 	kmem_add_extra_claims();
 
+#if defined(SAGIT) && (DEVELOPMENT || DEBUG)
+	printf("SAGIT kmem: ptr=%lluMB meta=%lluKB spray=%lluMB data=%lluMB min=%p max=%p\n",
+	    (unsigned long long)(ptr_range_size >> 20),
+	    (unsigned long long)(kmem_meta_size >> 10),
+	    (unsigned long long)(sprayqtn_range_size >> 20),
+	    (unsigned long long)(data_range_size >> 20),
+	    (void *)kernel_map->min_offset, (void *)kernel_map->max_offset);
+#endif
+
 	/*
 	 * Shuffle registered claims
 	 */
@@ -3639,6 +3659,10 @@
 		vm_map_offset_t end = 0;
 		struct kmem_range_startup_spec sp = kmem_claims[i];
 		struct mach_vm_range *sp_range = sp.kc_range;
+#if defined(SAGIT) && (DEVELOPMENT || DEBUG)
+		printf("SAGIT kmem claim %s size=%lluMB at=%p\n", sp.kc_name,
+		    (unsigned long long)(sp.kc_size >> 20), (void *)start);
+#endif
 		if (vm_map_locate_space(kernel_map, sp.kc_size, 0,
 		    VM_MAP_KERNEL_FLAGS_ANYWHERE(), &start, NULL) != KERN_SUCCESS) {
 			panic("kmem_range_init: vm_map_locate_space failing for claim %s",
